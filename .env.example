# Every server-side secret Sprout needs, by name only — never put real values
# in this file. It is committed; .env is not (see .gitignore).
#
# These are set in Vercel under Project Settings > Environment Variables, and
# Preview and Production each hold their own copy. Paystack and Paddle both
# keep test and live credentials completely separate, so the Preview values
# should be test credentials and Production values live ones.

# --- Supabase (already configured) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paddle: rest-of-world billing (already configured) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=production

# --- Paystack: South African billing (new) ---
# Secret key from the Paystack dashboard. This one key does two jobs: it
# authenticates our API calls AND is the key Paystack signs webhooks with, so
# api/paystack-webhook.js needs it too. sk_test_... on Preview, sk_live_... on
# Production — a test key cannot verify a live webhook signature, and vice versa.
PAYSTACK_SECRET_KEY=
# Plan codes, which differ between test and live. Test-mode codes as of
# 2026-08-24: monthly PLN_2dnq9cs7mhmpnkj, yearly PLN_kzb0wm57cf8wpj7.
PAYSTACK_PLAN_MONTHLY_ZA=
PAYSTACK_PLAN_YEARLY_ZA=

# Where Paystack sends a parent back to after they've entered their card. Must
# be the origin of the deployment itself (no trailing slash), or they'll be
# returned to the wrong environment: https://www.sproutearnsave.com in
# production, the preview URL on a preview deploy.
SITE_URL=

# --- Shared services (already configured) ---
LOOPS_API_KEY=
META_CAPI_ACCESS_TOKEN=
# Guards the daily cron jobs in vercel.json so only Vercel can trigger them.
CRON_SECRET=

# --- Web Push notifications (api/push-send.js) ---
# One VAPID key pair identifies Sprout to the browsers' push services. Generate
# with `node -e "console.log(require('web-push').generateVAPIDKeys())"`. The
# public key is also hard-coded in app/index.html (PUSH_PUBLIC_KEY) — if you
# ever rotate the pair, change both, and every parent has to re-enable
# notifications. VAPID_SUBJECT is the contact the push services may use.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@sproutearnsave.com
