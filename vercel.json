{
  "redirects": [
    {
      "source": "/instagram",
      "destination": "/app/index.html?utm_source=instagram&utm_medium=organic_social&utm_campaign=sa_launch&utm_content=bio_link",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/purge-canceled-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/paystack-retry-failed",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
